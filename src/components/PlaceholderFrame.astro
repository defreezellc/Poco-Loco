---
import type { FrameTone } from '../data/site';
import { sitePath } from '../lib/url';

interface Props {
  title: string;
  tone?: FrameTone;
  image?: string;
  imageAlt?: string;
  label?: string;
}

const { title, tone = 'mango', image, imageAlt, label = 'Sample image' } = Astro.props;
const raw = image?.trim();
const src = raw && raw.startsWith('/') ? sitePath(raw) : raw;
---

<div class="frame" data-tone={tone}>
  {
    src ? (
      <img src={src} alt={imageAlt || title} loading="lazy" decoding="async" />
    ) : (
      <span class="frame-label">{label}</span>
    )
  }
</div>
