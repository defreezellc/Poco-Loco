---
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/outfit/index.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title === site.name ? title : `${title} · ${site.name}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {!site.indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#fff4e4" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <p class="draft-banner">
      Sample site. The words, prices, dates, and pictures on these pages are placeholders.
    </p>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
